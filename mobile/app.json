{
  "expo": {
    "name": "Treino a Dois",
    "slug": "treino-a-dois",
    "version": "0.1.0",
    "scheme": "treinoadois",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0f14",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f14",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera tira a foto do treino na hora, para o seu par ver no feed.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A galeria é usada só para você escolher fotos de evolução. Elas ficam privadas.",
          "cameraPermission": "A câmera tira a foto do treino e as fotos de evolução."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A localização confere se você está na academia quando registra o treino."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0b0f14"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
