# Copie para .env.local e preencha com os mesmos dados do site (Supabase > Project Settings > API).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Endereço do site publicado. O app usa a função /api/maps-link dele para abrir links curtos do Google Maps.
EXPO_PUBLIC_SITE_URL=https://treino-a-dois-theta.vercel.app

# Opcional: busca de academias pelo nome no Google Maps (Places API).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
